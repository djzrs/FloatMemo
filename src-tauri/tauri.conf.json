{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloatMemo",
  "version": "0.2.1",
  "identifier": "app.floatmemo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "ball",
        "title": "浮笺",
        "url": "index.html",
        "width": 74,
        "height": 74,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "minWidth": 1,
        "minHeight": 1
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNzk4RDUyRUM5NUVCMzkKUldRNTY1WHNVbzE1d0hwdmRjUmplL0Nmbm5ZU3JteEt2ak5PSVgwaVErenFZVUFQN2lUbm9waG0K",
      "endpoints": [
        "https://github.com/djzrs/FloatMemo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
